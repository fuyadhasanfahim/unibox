# Postgres (docker-compose)
POSTGRES_USER=unibox
POSTGRES_PASSWORD=
POSTGRES_DB=unibox
POSTGRES_PORT=5432

# Redis (docker-compose, BullMQ)
REDIS_PASSWORD=
REDIS_PORT=6379

# apps/api
API_PORT=5000
# Must match POSTGRES_* above (url-encode special chars in the password)
DATABASE_URL=postgresql://unibox:<password>@127.0.0.1:5432/unibox
REDIS_URL=redis://:<password>@127.0.0.1:6379
# Comma-separated list of trusted browser origins (no wildcard)
CORS_ORIGINS=http://localhost:3000

# Auth (Better Auth). Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Public web origin: auth links in emails point here, /api is proxied to the API
APP_URL=http://localhost:3000

# Email (Resend). Empty in dev = links are logged to the API console instead of sent.
RESEND_API_KEY=
EMAIL_FROM=Unibox <onboarding@resend.dev>
# Dev inbox UI + API (docker mailpit). Leave empty in production.
MAILPIT_PORT=8025
MAILPIT_URL=

# Shared secret between the web proxy and the API (both apps). Generate: openssl rand -base64 48
# The API only trusts the forwarded client IP when this matches, so keep the API off the public internet.
INTERNAL_PROXY_SECRET=
# Header your load balancer/CDN sets with the real client IP (cf-connecting-ip, x-real-ip, ...).
# Required in production; in dev every request comes from localhost.
TRUSTED_CLIENT_IP_HEADER=

# Channel token encryption keys: "version:base64(32 bytes)", comma-separated, first one encrypts new tokens.
# Generate one: echo "v1:$(openssl rand -base64 32)". To rotate, put a new version first and keep the old one.
TOKEN_ENCRYPTION_KEYS=

# Meta app (WhatsApp, Messenger, Instagram). Set all three or none; the app id is numeric.
META_APP_ID=
META_APP_SECRET=
# Any random string; paste the same value in the Meta webhook settings. Generate: openssl rand -hex 24
META_WEBHOOK_VERIFY_TOKEN=
# Instagram app (Instagram use case > API setup with Instagram login). Set both or neither.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Pinned Graph API version
META_GRAPH_VERSION=v26.0

# apps/app
API_URL=http://localhost:5000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public web origin for the Docker app (tunnel hostname)
PUBLIC_APP_URL=

# Cloudflare named tunnel token (Zero Trust > Tunnels). Routes: unibox -> localhost:3000, uniboxapi -> localhost:5000
CLOUDFLARE_TUNNEL_TOKEN=
