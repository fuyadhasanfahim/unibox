# Postgres (docker-compose)
POSTGRES_USER=unibox
POSTGRES_PASSWORD=
POSTGRES_DB=unibox
POSTGRES_PORT=5432

# Redis (docker-compose, BullMQ)
REDIS_PASSWORD=
REDIS_PORT=6379

# apps/api
API_PORT=5000
# Must match POSTGRES_* above (url-encode special chars in the password)
DATABASE_URL=postgresql://unibox:<password>@127.0.0.1:5432/unibox
REDIS_URL=redis://:<password>@127.0.0.1:6379
# Comma-separated list of trusted browser origins (no wildcard)
CORS_ORIGINS=http://localhost:3000

# Auth (Better Auth). Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Public web origin: auth links in emails point here, /api is proxied to the API
APP_URL=http://localhost:3000

# Email (Resend). Empty in dev = links are logged to the API console instead of sent.
RESEND_API_KEY=
EMAIL_FROM=Unibox <onboarding@resend.dev>
# Dev inbox UI + API (docker mailpit). Leave empty in production.
MAILPIT_PORT=8025
MAILPIT_URL=

# apps/app
API_URL=http://localhost:5000
NEXT_PUBLIC_APP_URL=http://localhost:3000
